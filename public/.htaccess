# Static export served from https://lumako.ru/masterauto
Options -MultiViews
DirectoryIndex index.html

ErrorDocument 404 /masterauto/404.html

# MIME types the default shared-hosting config gets wrong
AddType model/gltf-binary .glb
AddType model/gltf+json .gltf
AddType font/otf .otf
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build output is immutable
  <FilesMatch "\.(js|css|woff2|otf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|glb|gltf)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
